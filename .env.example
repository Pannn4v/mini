# ==============================================================================
# MINI-INSTANTLY: ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. CRON SECURITY (For Vercel cron or external triggers)
# Protects the /api/cron/dispatch endpoint from unauthorized manual pings.
CRON_SECRET=sovereign_sequencer_secret_token_123

# 2. SUPABASE POSTGRESQL (Required for Vercel deployment persistence)
# Copy these from your Supabase Project Settings -> API.
# Note: SUPABASE_SERVICE_ROLE_KEY bypasses RLS on serverless routes safely.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your_service_role_key_here

# Optional: Anon key if testing client-side direct access
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your_anon_key_here
